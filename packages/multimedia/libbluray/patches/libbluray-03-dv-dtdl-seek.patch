 #include <inttypes.h>
 #include <string.h>
 
+/*
+ * DV DT-DL dual-stream state
+ */
+
+#define DV_PID_BL  0x1011
+#define DV_PID_EL  0x1015
+
+/* DV dual-stream state (minimal - seek only) */
+typedef struct {
+    int           active;     /* 1 if DV dual-stream mode is active */
+    int64_t       seek_pts;   /* seek target PTS, -1 if not seeking */
+} DV_STATE;
+
+
+/* Find EL SPN for a given PTS from the EL EP map */
+static uint32_t _dv_find_el_spn(const NAV_CLIP *clip, int64_t target_pts)
+{
+    if (!clip || !clip->cl || clip->cl->cpi.num_stream_pid < 2)
+        return (uint32_t)-1;
+
+    const CLPI_EP_MAP_ENTRY *el_ep = NULL;
+    for (unsigned i = 0; i < clip->cl->cpi.num_stream_pid; i++) {
+        if (clip->cl->cpi.entry[i].pid == DV_PID_EL) {
+            el_ep = &clip->cl->cpi.entry[i];
+            break;
+        }
+    }
+    if (!el_ep || el_ep->num_ep_coarse == 0) return (uint32_t)-1;
+
+    int64_t best_pts = -1;
+    uint32_t best_spn = 0;
+    for (unsigned i = 0; i < el_ep->num_ep_coarse; i++) {
+        int64_t coarse_pts = (int64_t)((el_ep->coarse[i].pts_ep & ~0x01) << 18);
+        if (coarse_pts <= target_pts && coarse_pts > best_pts) {
+            best_pts = coarse_pts;
+            int ref = el_ep->coarse[i].ref_ep_fine_id;
+            best_spn = (el_ep->coarse[i].spn_ep & ~0x1FFFF) + el_ep->fine[ref].spn_ep;
+        }
+    }
+    return best_spn;
+}
+
+static void _dv_init(DV_STATE *dv)
+{
+    memset(dv, 0, sizeof(*dv));
+}
+
+static void _dv_reset(DV_STATE *dv)
+{
+    dv->seek_pts = -1;
+}
+
 
 typedef enum {
     title_undef = 0,
@@ -178,6 +231,9 @@ struct bluray {
     bd_argb_overlay_proc_f argb_overlay_proc;
     BD_ARGB_BUFFER      *argb_buffer;
     BD_MUTEX             argb_buffer_mutex;
+
