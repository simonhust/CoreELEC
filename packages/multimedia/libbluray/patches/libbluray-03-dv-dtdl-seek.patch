+    DV_STATE             dv;
 };
 
 /* Stream Packet Number = byte offset / 192. Avoid 64-bit division. */
@@ -2088,8 +2144,22 @@ static void _playmark_reached(BLURAY *bd)
  */
 
 static void _seek_internal(BLURAY *bd,
-                           const NAV_CLIP *clip, uint32_t title_pkt, uint32_t clip_pkt)
-{
+                            const NAV_CLIP *clip, uint32_t title_pkt, uint32_t clip_pkt)
+{
+    /* DV DT-DL: seek to min(BL_SPN, EL_SPN) to avoid missing EL packets */
+    if (bd->dv.active) {
+        uint32_t seek_time = 0;
+        if (clip->cl) {
+            clpi_access_point(clip->cl, clip_pkt, 0, 0, &seek_time);
+            uint32_t el_spn = _dv_find_el_spn(clip, (int64_t)seek_time);
+            if (el_spn != (uint32_t)-1 && el_spn < clip_pkt) {
+                clip_pkt = el_spn;
+            }
+        }
+        _dv_reset(&bd->dv);
+        bd->dv.seek_pts = (int64_t)seek_time;
+    }
+
     if (_seek_stream(bd, &bd->st0, clip, clip_pkt) >= 0) {
         uint32_t media_time;
 
@@ -2177,6 +2247,10 @@ int64_t bd_seek_time(BLURAY *bd, uint64_t tick)
         // Find the closest access unit to the requested position
         clip = nav_time_search(bd->title, (uint32_t)tick, &clip_pkt, &out_pkt);
 
+        if (bd->dv.active) {
+            _dv_reset(&bd->dv);
+            bd->dv.seek_pts = (int64_t)tick;
+        }
         _seek_internal(bd, clip, out_pkt, clip_pkt);
 
     } else {
@@ -2921,6 +2995,7 @@ static int _open_playlist(BLURAY *bd, unsigned playlist, unsigned angle)
     bd->s_pos = 0;
     bd->end_of_playlist = 0;
     bd->st0.ig_pid = 0;
+    _dv_init(&bd->dv);
 
     // Get the initial clip of the playlist
     bd->st0.clip = nav_next_clip(bd->title, NULL);
@@ -2934,6 +3009,16 @@ static int _open_playlist(BLURAY *bd, unsigned playlist, unsigned angle)
         BD_DEBUG(DBG_BLURAY, "DV FEL EL sub-path enabled: %d\n", bd->dv_el_subpath);
     }
 
+    /* Detect DV DT-DL dual-stream */
+    if (bd->title->sub_path_count > 0) {
+        for (unsigned i = 0; i < bd->title->sub_path_count; i++) {
+            if (bd->title->sub_path[i].type == 10) {
+                bd->dv.active = 1;
+                BD_DEBUG(DBG_BLURAY, "DV DT-DL dual-stream detected (sub-path type 10)\n");
+                break;
+            }
+        }
+    }
 
     _update_playlist_psrs(bd);
 
